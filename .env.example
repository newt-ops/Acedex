# Root .env.example (mirrored in apps/api/.env.example)

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/acedex?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://acedex.vercel.app
LOG_LEVEL=info

# Initial Super Admin Email Whitelist (comma-separated)
ADMIN_EMAILS=admin@example.com
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-min-32-chars-change-me
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-min-32-chars-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Unity Ads Rewarded Integration
UNITY_ADS_ANDROID_GAME_ID=6220248
UNITY_ADS_IOS_GAME_ID=6220249
UNITY_ADS_ANDROID_PLACEMENT=Reward_Android_Acedex
UNITY_ADS_IOS_PLACEMENT=Rewarded_iOS
UNITY_ADS_SECRET_KEY=
UNITY_ADS_S2S_REQUIRED=false
REQUIRE_EXAM_TICKET=false

# Gemini AI Study Plan
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-2.0-flash-lite,gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
